# Environment Variables Template for Next.js Portfolio Boilerplate

# Copy this file to `.env.local` and fill in the values
# DO NOT commit `.env.local` to version control

# ============================================
# Site Configuration
# ============================================

# Site Name (appears in title, meta tags)
NEXT_PUBLIC_SITE_NAME="Your Portfolio"

# Site Description (appears in meta tags)
NEXT_PUBLIC_SITE_DESCRIPTION="A modern portfolio and blog showcasing my work and expertise"

# Base URL for the application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Open Graph Image URL (relative to public folder)
NEXT_PUBLIC_OG_IMAGE="/images/open-graph-image.png"

# ============================================
# User Information
# ============================================

# Personal Details
NEXT_PUBLIC_USER_FIRST_NAME="Your"
NEXT_PUBLIC_USER_LAST_NAME="Name"
NEXT_PUBLIC_USER_DISPLAY_NAME="Your Name"
NEXT_PUBLIC_USER_USERNAME="yourusername"
NEXT_PUBLIC_USER_GENDER="male" # or "female" or "other"
NEXT_PUBLIC_USER_PRONOUNS="he/him" # or "she/her" or "they/them"
NEXT_PUBLIC_USER_BIO="Brief bio about yourself"

# Contact Information
CONTACT_EMAIL="your@email.com"
NEXT_PUBLIC_USER_EMAIL="your@email.com"
NEXT_PUBLIC_USER_PHONE="" # Optional: E.164 format
NEXT_PUBLIC_USER_WEBSITE="https://yourwebsite.com"

# Job Information
NEXT_PUBLIC_USER_JOB_TITLE="Software Developer"
NEXT_PUBLIC_USER_COMPANY="Your Company"
NEXT_PUBLIC_USER_COMPANY_WEBSITE="https://yourcompany.com"

# About Section
NEXT_PUBLIC_USER_ABOUT="Detailed about section content"

# Avatar and Images
NEXT_PUBLIC_USER_AVATAR="/images/avatar.jpg"
NEXT_PUBLIC_USER_OG_IMAGE="/images/open-graph-image.png"

# ============================================
# Social Links
# ============================================

NEXT_PUBLIC_SOCIAL_TWITTER="https://twitter.com/yourusername"
NEXT_PUBLIC_SOCIAL_GITHUB="https://github.com/yourusername"
NEXT_PUBLIC_SOCIAL_LINKEDIN="https://linkedin.com/in/yourusername"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/yourusername"
NEXT_PUBLIC_SOCIAL_YOUTUBE="https://youtube.com/@yourusername"

# ============================================
# SEO and Keywords
# ============================================

# SEO Keywords (comma-separated)
NEXT_PUBLIC_SEO_KEYWORDS="portfolio,blog,developer,react,nextjs"

# ============================================
# Feature Toggles
# ============================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_SHOP=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_PROJECTS=true
NEXT_PUBLIC_ENABLE_CONTACT=true

# ============================================
# Third-party Services
# ============================================

# Resend API Key (Required for contact form)
# Get your API key from: https://resend.com/
RESEND_API_KEY=your_resend_api_key

# Stripe (Required for shop functionality)
# Get your keys from: https://stripe.com/
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Analytics (Optional)
# Get your Measurement ID from: https://analytics.google.com/
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Meta Pixel (Optional)
# Get your Pixel ID from: https://www.facebook.com/business/help/952192354722245
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# PostHog Analytics (Optional)
# Get your API key from: https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://app.posthog.com

# Vercel Analytics (automatically provided by Vercel)
# No configuration needed if deployed on Vercel

# IndexNow API Key (Required for instant search engine indexing)
# Generate your API key at: https://www.bing.com/indexnow/getstarted
# This enables instant indexing with Bing, Yandex, and other IndexNow participants
INDEXNOW_API_KEY=your_indexnow_api_key

# ============================================
# Additional API Keys
# ============================================

# Add any additional API keys or secrets here
# Example:
# GITHUB_TOKEN=your_github_token
# TWITTER_API_KEY=your_twitter_api_key